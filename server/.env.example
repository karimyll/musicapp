# Generate with: openssl rand -hex 32
API_TOKEN=change-me

# Your domain, or <server-ip-with-dashes>.sslip.io if you have none (e.g. 65-21-10-20.sslip.io)
DOMAIN=music.example.com

CACHE_MAX_GB=2
CACHE_TTL_HOURS=24

# Optional: Netscape cookies.txt from a throwaway YouTube account, if YouTube blocks the server IP.
# Put it in server/cookies/ and point here:
# COOKIES_FILE=/data/cookies/cookies.txt
