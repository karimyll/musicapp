# syntax=docker/dockerfile:1
# Generated by build-coolify-dockerfile.sh — do not edit by hand.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=denoland/deno:bin /deno /usr/local/bin/deno
WORKDIR /srv
COPY <<'EOF_REQ' requirements.txt
fastapi==0.115.6
uvicorn[standard]==0.34.0
ytmusicapi>=1.10.0
yt-dlp[default]
EOF_REQ
RUN pip install --no-cache-dir -r requirements.txt
COPY <<'EOF_MAIN' app/main.py
"""Personal music API: search YouTube Music, fetch audio as m4a for the iOS app."""

import os
import re
import secrets
import shutil
import subprocess
import threading
import time
from pathlib import Path

import yt_dlp
from fastapi import Depends, FastAPI, Header, HTTPException, Query
from fastapi.responses import FileResponse
from ytmusicapi import YTMusic

API_TOKEN = os.environ.get("API_TOKEN", "")
CACHE_DIR = Path(os.environ.get("CACHE_DIR", "/data/cache"))
CACHE_MAX_BYTES = int(float(os.environ.get("CACHE_MAX_GB", "2")) * 1024**3)
CACHE_TTL_SECONDS = int(float(os.environ.get("CACHE_TTL_HOURS", "24")) * 3600)
COOKIES_FILE = os.environ.get("COOKIES_FILE", "/data/cookies/cookies.txt")
# yt-dlp rewrites the cookie jar after each request; mounted files may be read-only, so work on a copy.
COOKIES_WORK = Path("/tmp/yt-cookies.txt")

if not API_TOKEN:
    raise RuntimeError("API_TOKEN env var is required")


def _cookie_file() -> str | None:
    src = Path(COOKIES_FILE)
    if not src.is_file() or src.stat().st_size == 0:
        return None
    if not COOKIES_WORK.exists() or src.stat().st_mtime > COOKIES_WORK.stat().st_mtime:
        shutil.copyfile(src, COOKIES_WORK)
    return str(COOKIES_WORK)


print(f"cookies: {'loaded from ' + COOKIES_FILE if _cookie_file() else 'none'}", flush=True)

if not shutil.which("ffmpeg"):
    # Without ffmpeg yt-dlp can't fix YouTube's DASH m4a container (wrong duration/seeking on iOS).
    print("WARNING: ffmpeg not found; downloaded m4a files will not be fixed up", flush=True)

CACHE_DIR.mkdir(parents=True, exist_ok=True)
VIDEO_ID_RE = re.compile(r"^[A-Za-z0-9_-]{11}$")

app = FastAPI(title="musicapp", docs_url=None, redoc_url=None)
ytmusic = YTMusic()

_locks: dict[str, threading.Lock] = {}
_locks_guard = threading.Lock()


def require_token(authorization: str = Header(default="")) -> None:
    expected = f"Bearer {API_TOKEN}"
    if not secrets.compare_digest(authorization.encode(), expected.encode()):
        raise HTTPException(status_code=401, detail="unauthorized")


def _best_thumb(thumbs: list[dict] | None) -> str | None:
    if not thumbs:
        return None
    url = max(thumbs, key=lambda t: t.get("width", 0)).get("url")
    # Ask Google's image CDN for a larger square cover when possible.
    if url and "googleusercontent.com" in url:
        url = re.sub(r"=w\d+-h\d+.*$", "=w544-h544-l90-rj", url)
    return url


def _parse_length(s: str | None) -> int | None:
    """'3:21' or '1:02:03' -> seconds."""
    if not s or not re.fullmatch(r"\d+(:\d{1,2}){1,2}", s):
        return None
    secs = 0
    for part in s.split(":"):
        secs = secs * 60 + int(part)
    return secs


def _artists(r: dict) -> str:
    return ", ".join(a["name"] for a in r.get("artists") or [] if a.get("name"))


def _song(r: dict, album: str | None = None, thumb: str | None = None) -> dict | None:
    """Normalize a ytmusicapi track (search / playlist / album / watch) to the app's song shape."""
    vid = r.get("videoId")
    if not vid or not VIDEO_ID_RE.match(vid):
        return None
    alb = r.get("album")
    return {
        "id": vid,
        "title": r.get("title") or "",
        "artist": _artists(r),
        "album": (alb.get("name") if isinstance(alb, dict) else alb) or album,
        "duration": r.get("duration_seconds") or _parse_length(r.get("duration") or r.get("length")),
        "thumbnail": _best_thumb(r.get("thumbnails") or r.get("thumbnail")) or thumb,
    }


def _songs(items: list[dict], album: str | None = None, thumb: str | None = None) -> list[dict]:
    out, seen = [], set()
    for r in items or []:
        s = _song(r, album, thumb)
        if s and s["id"] not in seen:
            seen.add(s["id"])
            out.append(s)
    return out


def _search_ytmusic(q: str, limit: int) -> list[dict]:
    return _songs(ytmusic.search(q, filter="songs", limit=limit))[:limit]


def _search_youtube(q: str, limit: int) -> list[dict]:
    opts = {"quiet": True, "extract_flat": True, "skip_download": True}
    with yt_dlp.YoutubeDL(opts) as ydl:
        info = ydl.extract_info(f"ytsearch{limit}:{q}", download=False)
    out = []
    for e in info.get("entries") or []:
        vid = e.get("id")
        if not vid or not VIDEO_ID_RE.match(vid):
            continue
        out.append(
            {
                "id": vid,
                "title": e.get("title") or "",
                "artist": e.get("channel") or e.get("uploader") or "",
                "album": None,
                "duration": int(e["duration"]) if e.get("duration") else None,
                "thumbnail": f"https://i.ytimg.com/vi/{vid}/hqdefault.jpg",
            }
        )
    return out


@app.get("/health")
def health() -> dict:
    return {"ok": True, "yt_dlp": yt_dlp.version.__version__}


@app.get("/search", dependencies=[Depends(require_token)])
def search(
    q: str = Query(min_length=1, max_length=200),
    limit: int = Query(20, ge=1, le=50),
    type: str = Query("songs", pattern="^(songs|albums)$"),
) -> list[dict]:
    if type == "albums":
        try:
            results = ytmusic.search(q, filter="albums", limit=limit)
        except Exception as e:
            raise HTTPException(status_code=424, detail=f"search failed: {e}") from e
        return [
            {
                "id": r["browseId"],
                "title": r.get("title") or "",
                "artist": _artists(r) or r.get("artist") or "",
                "year": r.get("year"),
                "thumbnail": _best_thumb(r.get("thumbnails")),
            }
            for r in results
            if r.get("browseId")
        ][:limit]
    try:
        results = _search_ytmusic(q, limit)
    except Exception:
        results = []
    if not results:
        try:
            results = _search_youtube(q, min(limit, 15))
        except Exception as e:
            raise HTTPException(status_code=502, detail=f"search failed: {e}") from e
    return results


BROWSE_ID_RE = re.compile(r"^[A-Za-z0-9_-]{6,80}$")


def _collection(title: str, author: str, thumb: str | None, tracks: list[dict], year=None) -> dict:
    return {"title": title, "author": author, "year": year, "thumbnail": thumb, "tracks": tracks}


def _album(browse_id: str) -> dict:
    a = ytmusic.get_album(browse_id)
    thumb = _best_thumb(a.get("thumbnails"))
    return _collection(a.get("title") or "", _artists(a), thumb,
                       _songs(a.get("tracks"), album=a.get("title"), thumb=thumb), a.get("year"))


@app.get("/radio/{video_id}", dependencies=[Depends(require_token)])
def radio(video_id: str, limit: int = Query(25, ge=1, le=50)) -> list[dict]:
    """Songs similar to video_id (YouTube Music 'radio'), without the seed song itself."""
    if not VIDEO_ID_RE.match(video_id):
        raise HTTPException(status_code=400, detail="bad video id")
    try:
        w = ytmusic.get_watch_playlist(videoId=video_id, radio=True, limit=limit + 1)
    except Exception as e:
        raise HTTPException(status_code=424, detail=f"radio failed: {e}") from e
    return [s for s in _songs(w.get("tracks")) if s["id"] != video_id][:limit]


@app.get("/album/{browse_id}", dependencies=[Depends(require_token)])
def album(browse_id: str) -> dict:
    if not BROWSE_ID_RE.match(browse_id):
        raise HTTPException(status_code=400, detail="bad album id")
    try:
        return _album(browse_id)
    except Exception as e:
        raise HTTPException(status_code=424, detail=f"album failed: {e}") from e


@app.get("/playlist", dependencies=[Depends(require_token)])
def playlist(url: str = Query(min_length=2, max_length=500)) -> dict:
    """Import a YouTube / YouTube Music playlist or album from a link (or a raw id)."""
    url = url.strip()
    m = re.search(r"[?&]list=([A-Za-z0-9_-]+)", url)
    pid = m.group(1) if m else None
    b = re.search(r"/browse/([A-Za-z0-9_-]+)", url)
    if not pid and b:
        bid = b.group(1)
        if bid.startswith("MPREb"):
            try:
                return _album(bid)
            except Exception as e:
                raise HTTPException(status_code=424, detail=f"album failed: {e}") from e
        pid = bid[2:] if bid.startswith("VL") else bid
    if not pid and BROWSE_ID_RE.match(url):
        pid = url
    if not pid:
        raise HTTPException(status_code=400, detail="Not a YouTube playlist or album link.")
    try:
        if pid.startswith("RD"):  # auto-generated mixes
            w = ytmusic.get_watch_playlist(playlistId=pid, limit=100)
            tracks = _songs(w.get("tracks"))
            return _collection("Mix", "YouTube", tracks[0]["thumbnail"] if tracks else None, tracks)
        p = ytmusic.get_playlist(pid, limit=500)
        author = p.get("author")
        author = author.get("name") if isinstance(author, dict) else (author or "")
        return _collection(p.get("title") or "Playlist", author, _best_thumb(p.get("thumbnails")),
                           _songs(p.get("tracks")), p.get("year"))
    except Exception:
        pass
    # Fallback for playlists YouTube Music can't read: plain YouTube via yt-dlp.
    try:
        with yt_dlp.YoutubeDL({"quiet": True, "extract_flat": True, "skip_download": True}) as ydl:
            info = ydl.extract_info(f"https://www.youtube.com/playlist?list={pid}", download=False)
    except Exception as e:
        raise HTTPException(status_code=424, detail="Couldn't read this playlist. Is it public?") from e
    tracks = [
        {"id": e["id"], "title": e.get("title") or "", "artist": e.get("channel") or e.get("uploader") or "",
         "album": None, "duration": int(e["duration"]) if e.get("duration") else None,
         "thumbnail": f"https://i.ytimg.com/vi/{e['id']}/hqdefault.jpg"}
        for e in info.get("entries") or [] if e.get("id") and VIDEO_ID_RE.match(e["id"])
    ]
    return _collection(info.get("title") or "Playlist", info.get("uploader") or "",
                       tracks[0]["thumbnail"] if tracks else None, tracks)


def _lock_for(video_id: str) -> threading.Lock:
    with _locks_guard:
        return _locks.setdefault(video_id, threading.Lock())


def _cleanup_cache() -> None:
    now = time.time()
    files = []
    for p in CACHE_DIR.iterdir():
        if not p.is_file():
            continue
        st = p.stat()
        # Stale partial downloads and expired files go first.
        if now - st.st_mtime > CACHE_TTL_SECONDS or (p.suffix == ".part" and now - st.st_mtime > 3600):
            p.unlink(missing_ok=True)
            continue
        files.append((st.st_mtime, st.st_size, p))
    total = sum(s for _, s, _ in files)
    for _, size, p in sorted(files):
        if total <= CACHE_MAX_BYTES:
            break
        p.unlink(missing_ok=True)
        total -= size


def _download(video_id: str) -> Path:
    target = CACHE_DIR / f"{video_id}.m4a"
    if target.exists():
        target.touch()
        return target
    opts = {
        "quiet": True,
        "no_warnings": True,
        "noprogress": True,
        "noplaylist": True,
        # Prefer native AAC/m4a so no transcoding is needed on a small server.
        "format": "bestaudio[ext=m4a]/bestaudio",
        "outtmpl": str(CACHE_DIR / f"{video_id}.%(ext)s"),
    }
    if cookies := _cookie_file():
        opts["cookiefile"] = cookies
    with yt_dlp.YoutubeDL(opts) as ydl:
        info = ydl.extract_info(f"https://www.youtube.com/watch?v={video_id}", download=True)
        downloaded = Path(ydl.prepare_filename(info))
    if downloaded != target:
        # Rare: no m4a stream (e.g. opus/webm only). iOS can't play webm, so convert to AAC.
        tmp = target.with_suffix(".tmp.m4a")
        subprocess.run(
            ["ffmpeg", "-y", "-loglevel", "error", "-i", str(downloaded), "-vn", "-c:a", "aac", "-b:a", "160k", str(tmp)],
            check=True,
        )
        tmp.rename(target)
        downloaded.unlink(missing_ok=True)
    if not target.exists():
        raise RuntimeError("download finished but m4a file is missing")
    return target


@app.get("/audio/{video_id}", dependencies=[Depends(require_token)])
def audio(video_id: str) -> FileResponse:
    if not VIDEO_ID_RE.match(video_id):
        raise HTTPException(status_code=400, detail="bad video id")
    with _lock_for(video_id):
        try:
            path = _download(video_id)
        except Exception as e:
            msg = str(e)
            if "confirm you" in msg and "not a bot" in msg:
                msg = ("YouTube blocked the server (bot check). Add a cookies.txt from a spare "
                       "YouTube account in Coolify — see README.")
            elif "Video unavailable" in msg or "Private video" in msg:
                msg = "This video is unavailable."
            # 424 (not 502) so proxies like Cloudflare pass our JSON error through to the app.
            raise HTTPException(status_code=424, detail=msg) from e
    try:
        _cleanup_cache()
    except Exception:
        pass
    return FileResponse(path, media_type="audio/mp4", filename=f"{video_id}.m4a")
EOF_MAIN
COPY <<'EOF_ENTRY' entrypoint.sh
#!/bin/sh
set -e
# YouTube changes often; keep yt-dlp fresh on every start (failure is not fatal).
pip install --no-cache-dir -q -U "yt-dlp[default]" || echo "yt-dlp update skipped"
exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --proxy-headers
EOF_ENTRY
RUN chmod +x entrypoint.sh && touch app/__init__.py && useradd -m -u 1000 app && mkdir -p /data/cache && chown -R app:app /data /srv /usr/local/lib/python3.12/site-packages /usr/local/bin
USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request;urllib.request.urlopen(\"http://127.0.0.1:8000/health\")"
ENTRYPOINT ["./entrypoint.sh"]
